{
  "name": "@abos/e1-integration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 --experimental-strip-types src/*.test.ts",
    "clean": "node -e \"require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "sandbox:seed": "node --experimental-strip-types scripts/dev-sandbox.ts seed",
    "sandbox:sessions": "node --experimental-strip-types scripts/dev-sandbox.ts sessions",
    "preview:seed": "node --experimental-strip-types scripts/preview-seed.ts",
    "local:setup": "node --experimental-strip-types scripts/local-review.ts setup",
    "local:status": "node --experimental-strip-types scripts/local-review.ts status",
    "local:reset": "node --experimental-strip-types scripts/local-review.ts reset"
  },
  "dependencies": {
    "@abos/contracts": "workspace:*",
    "@abos/database": "workspace:*",
    "@abos/calendar": "workspace:*",
    "@abos/finance": "workspace:*",
    "@abos/identity": "workspace:*",
    "@abos/persistence": "workspace:*",
    "@abos/sandbox-auth": "workspace:*",
    "@abos/shareholder": "workspace:*",
    "@abos/treasury": "workspace:*",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5"
  }
}
