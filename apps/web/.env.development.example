NEXT_PUBLIC_APP_NAME=AL-BERUNIY Operating System
NEXT_PUBLIC_APP_ENV=development
# Treasury E1 synthetic sandbox (server-only). Copy to .env.local for local use.
# The Treasury page answers 503 when these are absent; it never falls back to demo data.
ABOS_DATABASE_URL=
# Separate logins that inherit only their matching restricted runtime role. Never reuse
# ABOS_DATABASE_URL here. Example shape: postgres://<treasury-login>:<local-password>@127.0.0.1:55432/<dev-db>
ABOS_TREASURY_DATABASE_URL=
ABOS_FINANCE_DATABASE_URL=
# Employee sign-in and administration: its own login inheriting only abos_v1_identity_runtime.
ABOS_IDENTITY_DATABASE_URL=
# Developer token sign-in for automated tests only. Leave unset for any preview or shared server.
# ABOS_ALLOW_DEV_TOKEN_SIGNIN=1
ABOS_ENVIRONMENT=development
ABOS_SANDBOX_RUNTIME_MARKER=
ABOS_SANDBOX_SIGNING_SECRET=
ABOS_SANDBOX_MAX_SESSION_SECONDS=3600
